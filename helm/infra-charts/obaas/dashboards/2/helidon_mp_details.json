{
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "name": "",
  "generateName": true,
  "tags": [],
  "spec": {
    "display": {
      "name": "Helidon MP Details",
      "description": "Helidon MP Applications Details"
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "namespace",
            "description": ""
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/QueryVariable",
            "spec": {
              "queryValue": "SELECT distinct JSONExtractString(labels, 'kubernetes_namespace') \nFROM signoz_metrics.distributed_time_series_v4\nWHERE (metric_name = 'jvm_memory_used_bytes')\nand (JSONExtractString(labels, 'kubernetes_namespace') != '')"
            }
          },
          "name": "namespace"
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "app_name",
            "description": ""
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/QueryVariable",
            "spec": {
              "queryValue": "SELECT distinct JSONExtractString(labels, 'mp_app')\nFROM signoz_metrics.distributed_time_series_v4\nWHERE (metric_name = 'jvm_uptime_seconds')\nand (JSONExtractString(labels, 'kubernetes_namespace') in {{.namespace}})\n"
            }
          },
          "name": "app_name"
        }
      }
    ],
    "panels": {
      "2a5b1786-fc4d-4af3-baf4-fbde9ddda42d": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total Heap Used %",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "thresholds": [
                {
                  "value": 90,
                  "operator": "above",
                  "unit": "percentunit",
                  "color": "Red",
                  "format": "text"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(last_over_time(memory_usedHeap_bytes{kubernetes_namespace=~\"$namespace\",mp_app=~\"$app_name\"}[2m])) / sum(last_over_time(memory_maxHeap_bytes{kubernetes_namespace=~\"$namespace\",mp_app=~\"$app_name\"}[2m]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
