    "panels": {
      "1cbe9083-9b5f-4165-b3d0-1470c94d665a": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "In-Sync Replicas (ISR)",
            "description": "Count of in-sync replicas for each partition to ensure data availability."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/ClickHouseSQL",
                  "spec": {
                    "name": "A",
                    "query": "SELECT\n    toStartOfMinute(fromUnixTimestamp64Milli(s.unix_milli)) as time,\n    avg(s.value) as value,\n    concat(t.attrs['topic'], ' [P', t.attrs['partition'], ']') as name\nFROM signoz_metrics.distributed_samples_v4 AS s\nINNER JOIN signoz_metrics.distributed_time_series_v4 AS t ON s.fingerprint = t.fingerprint\nWHERE s.metric_name = 'kafka.partition.replicas_in_sync'\nGROUP BY time, name\nORDER BY time ASC\n",
                    "disabled": false,
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
