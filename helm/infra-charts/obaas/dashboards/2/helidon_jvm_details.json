                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(last_over_time(vthreads_recentPinned_seconds{kubernetes_namespace=~\"$namespace\",mp_app=~\"$app_name\",quantile=\"0.95\"}[2m]))",
                    "disabled": false,
