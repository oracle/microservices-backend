          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/QueryVariable",
            "spec": {
              "queryValue": "\nSELECT JSONExtractString(labels, 'service.name') AS service_name\nFROM signoz_metrics.time_series_v4_1day\nWHERE (metric_name = 'signoz_calls_total') AND (unix_milli \u003e= (toUnixTimestamp(now() - toIntervalDay(1)) * 1000))\nGROUP BY service_name"
            }
          },
          "name": "app_name"
        }
      }
