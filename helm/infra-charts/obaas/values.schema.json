{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "microtxPersistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "retain": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "signoz": {
      "type": "object",
      "properties": {
        "setup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "otmm": {
      "type": "object",
      "properties": {
        "commonConfiguration": {
          "type": "object",
          "properties": {
            "security": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "clientSecretName": { "type": "string" },
                "identityProvider": {
                  "type": "object",
                  "properties": {
                    "issuer": { "type": "string" },
                    "jwksUri": { "type": "string" },
                    "identityProviderUrl": { "type": "string" },
                    "audience": { "type": "string" },
                    "scopes": { "type": "string" },
                    "serverType": {
                      "enum": ["idcs", "other"]
                    },
                    "roleMappings": {
                      "type": "object",
                      "properties": {
                        "coordinator": {
                          "type": "object",
                          "properties": {
                            "adminUserRoles": { "type": "string" },
                            "adminUserRolesPath": { "type": "string" }
                          }
                        },
                        "workflow": {
                          "type": "object",
                          "properties": {
                            "claimsRolePaths": { "type": "string" },
                            "roles": {
                              "type": "object",
                              "properties": {
                                "superAdmin": { "type": "string" },
                                "admin": { "type": "string" },
                                "user": { "type": "string" },
                                "readOnlyUser": { "type": "string" },
                                "metadataManager": { "type": "string" },
                                "worker": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "coordinator": {
          "type": "object",
          "properties": {
            "authentication": {
              "type": "object",
              "properties": {
                "requestsWithNoJWT": {
                  "enum": ["", "ALLOW", "DENY"]
                }
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["memory", "db", "etcd"] },
                "db": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "initializeSchema": { "type": "boolean" },
                    "connectionString": { "type": "string" },
                    "connectionParams": { "type": "string" },
                    "credentialSecretName": { "type": "string" },
                    "credentialSecretKey": { "type": "string", "minLength": 1 },
                    "walletConfigMapName": { "type": "string" },
                    "walletSecretName": { "type": "string" }
                  }
                },
                "etcd": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "endpoints": { "type": "string" },
                    "skipHostNameVerification": { "type": "boolean" },
                    "credentialSecretName": { "type": "string" },
                    "credentialSecretKey": { "type": "string", "minLength": 1 },
                    "caConfigMapName": { "type": "string" },
                    "caConfigMapKey": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "console": {
          "type": "object",
          "properties": {
            "cookieEncryption": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "workflowServer": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "storage": {
                  "type": "object",
                  "properties": {
                    "fileSystem": {
                      "type": "object",
                      "properties": {
                        "persistence": { "$ref": "#/$defs/microtxPersistence" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] }
            ]
          },
          "description": "Image pull secrets must be a list (strings or {name: ...} objects), not a bare string. Use --set global.imagePullSecrets[0]=mysecret"
        }
      }
    },
    "signozUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "target", "backup", "validation"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["standard", "stage1", "stage2"]
        },
        "mode": {
          "type": "string",
          "enum": ["destructive-replace"]
        },
        "confirmDataLoss": { "type": "boolean" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chartVersion", "signozVersion", "otelCollectorVersion", "clickhouseVersion"],
          "properties": {
            "chartVersion": { "type": "string", "enum": ["0.142.1"] },
            "signozVersion": { "type": "string", "enum": ["v0.142.1"] },
            "otelCollectorVersion": { "type": "string", "enum": ["v0.144.10"] },
            "clickhouseVersion": { "type": "string", "enum": ["25.12.5"] }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "volumeSnapshotClassName", "volumeSnapshotClassByStorageClass", "timeout"],
          "properties": {
            "provider": { "type": "string", "enum": ["csi"] },
            "volumeSnapshotClassName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "volumeSnapshotClassByStorageClass": {
              "type": "object",
              "propertyNames": {
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            },
            "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout", "markerSecretName"],
          "properties": {
            "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" },
            "markerSecretName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowSameNamespace": { "type": "boolean" },
        "allowPublicIngress": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" },
        "dns": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "coherence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] }
            ]
          }
        },
        "jvm": { "type": "object" },
        "ports": { "type": "array" },
        "coherence": { "type": "object" },
        "resources": { "type": "object" }
      }
    }
  }
}
