<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>com.cloudbank</groupId>
	<artifactId>cloudbank-ai</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>CloudBank AI</name>
	<description>CloudBank AI demonstrates OBaaS and the Oracle AI Database</description>

	<properties>
		<java.version>25</java.version>
		<springai.version>2.0.2</springai.version>
		<oci-java-sdk.version>3.101.0</oci-java-sdk.version>
		<spring-cloud.version>2025.1.4</spring-cloud.version>
		<org.springdoc-version>3.2.0</org.springdoc-version>
		<bouncycastle.version>1.86</bouncycastle.version>
		<oracle-springboot-starter.version>26.3.0</oracle-springboot-starter.version>
		<liquibase.version>5.0.4</liquibase.version>
		<pdfbox.version>3.0.8</pdfbox.version>
		<jkube.version>1.20.0</jkube.version>
		<image.registry>localhost</image.registry>
		<!-- Oracle's provider and Spring AI have independent release schedules. -->
		<oracle-spring-ai.version>2.0.1</oracle-spring-ai.version>
		<jackson-bom.version>3.3.0</jackson-bom.version>
		<jackson-2-bom.version>2.23.0</jackson-2-bom.version>
		<logback.version>1.6.6</logback.version>
		<slf4j.version>2.0.20</slf4j.version>
		<caffeine.version>3.3.1</caffeine.version>
		<commons-lang3.version>3.21.0</commons-lang3.version>
		<mockito.version>5.24.0</mockito.version>
		<junit-jupiter.version>6.1.3</junit-jupiter.version>
		<testng.version>7.12.0</testng.version>
		<httpclient4.version>4.5.14</httpclient4.version>
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
		<maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
		<maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
		<native-build-tools-plugin.version>1.1.18</native-build-tools-plugin.version>
		<argLine/>
	</properties>

	<modules>
		<module>src/loan-application-service</module>
		<module>src/document-ingest</module>
		<module>src/document-review-service</module>
		<module>src/decision-service</module>
		<module>src/ai-agent-service</module>
		<module>src/azn-server</module>
		<module>src/geographic-risk-service</module>
		<module>src/policy-embedding-support</module>
		<module>src/policy-retrieval-service</module>
		<module>src/policy-loader</module>
		<module>src/workflow-token-refresh-worker</module>
		<module>src/gateway-bff-service</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
			    <groupId>org.springframework.ai</groupId>
			    <artifactId>spring-ai-bom</artifactId>
			    <version>${springai.version}</version>
			    <type>pom</type>
			    <scope>import</scope>
			</dependency>
			<!-- Eureka still brings the legacy HTTP client; keep its security fixes. -->
			<dependency>
			    <groupId>org.apache.httpcomponents</groupId>
			    <artifactId>httpclient</artifactId>
			    <version>${httpclient4.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Java 25 blocks Mockito's deprecated self-attach path; run Mockito as a test JVM agent. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
