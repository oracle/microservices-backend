apiVersion: v1
kind: ConfigMap
metadata:
  name: microtx-azn-oidc-bridge
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: microtx-azn-oidc-bridge
data:
  nginx.conf: |
    worker_processes 1;
    pid /tmp/nginx.pid;
    error_log /dev/stderr warn;
    events { worker_connections 128; }
    http {
      access_log off;
      client_body_temp_path /tmp/client_body;
      proxy_temp_path /tmp/proxy;
      server {
        listen 8080;
        server_name _;

        location = /.well-known/openid-configuration {
          proxy_pass __AZN_CLUSTER_URL__/.well-known/openid-configuration;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_set_header Accept-Encoding "";
          proxy_buffering on;
          proxy_ssl_server_name on;
          sub_filter_types application/json;
          sub_filter_once on;
          # Browser-facing endpoints retain the localhost issuer. Rewrite only
          # endpoints that the Console calls from inside its pod.
          sub_filter '"token_endpoint":"__AZN_ISSUER_URI__/oauth2/token"' '"token_endpoint":"__OIDC_BRIDGE_URL__/oauth2/token"';
          sub_filter '"jwks_uri":"__AZN_ISSUER_URI__/oauth2/jwks"' '"jwks_uri":"__OIDC_BRIDGE_URL__/oauth2/jwks"';
          sub_filter '"userinfo_endpoint":"__AZN_ISSUER_URI__/userinfo"' '"userinfo_endpoint":"__OIDC_BRIDGE_URL__/userinfo"';
          sub_filter '"introspection_endpoint":"__AZN_ISSUER_URI__/oauth2/introspect"' '"introspection_endpoint":"__OIDC_BRIDGE_URL__/oauth2/introspect"';
          sub_filter '"revocation_endpoint":"__AZN_ISSUER_URI__/oauth2/revoke"' '"revocation_endpoint":"__OIDC_BRIDGE_URL__/oauth2/revoke"';
        }

        location = /oauth2/token {
          proxy_pass __AZN_CLUSTER_URL__/oauth2/token;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_request_buffering on;
          proxy_buffering on;
          proxy_ssl_server_name on;
          proxy_hide_header Content-Length;
          chunked_transfer_encoding on;
        }

        location = /oauth2/jwks {
          proxy_pass __AZN_CLUSTER_URL__/oauth2/jwks;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_buffering on;
          proxy_ssl_server_name on;
        }

        location = /userinfo {
          proxy_pass __AZN_CLUSTER_URL__/userinfo;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_request_buffering on;
          proxy_buffering on;
          proxy_ssl_server_name on;
        }

        location = /oauth2/revoke {
          proxy_pass __AZN_CLUSTER_URL__/oauth2/revoke;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_request_buffering on;
          proxy_buffering on;
          proxy_ssl_server_name on;
        }

        location = /oauth2/introspect {
          proxy_pass __AZN_CLUSTER_URL__/oauth2/introspect;
          proxy_http_version 1.1;
          proxy_set_header Host __AZN_AUTHORITY__;
          proxy_set_header Connection "";
          proxy_request_buffering on;
          proxy_buffering on;
          proxy_ssl_server_name on;
        }

        location / { return 404; }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: microtx-azn-oidc-bridge
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: microtx-azn-oidc-bridge
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: microtx-azn-oidc-bridge
  template:
    metadata:
      labels:
        app.kubernetes.io/name: microtx-azn-oidc-bridge
    spec:
      automountServiceAccountToken: false
      containers:
        - name: bridge
          image: docker.io/nginxinc/nginx-unprivileged@sha256:28d91bdce70ad09025ea901458fdd149259d8e05982ade79d4ef2c0d9470eb48
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: tmp
              mountPath: /tmp
            - name: cache
              mountPath: /var/cache/nginx
          readinessProbe:
            httpGet:
              path: /.well-known/openid-configuration
              port: http
            periodSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
      volumes:
        - name: config
          configMap:
            name: microtx-azn-oidc-bridge
        - name: tmp
          emptyDir: {}
        - name: cache
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: microtx-azn-oidc-bridge
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: microtx-azn-oidc-bridge
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: microtx-azn-oidc-bridge
  ports:
    - name: http
      port: 8080
      targetPort: http
